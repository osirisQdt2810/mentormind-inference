# mentormind-inference — copy to .env and edit. Every variable is optional.
# --- VLM (python -m vlm_server serve) ---
# VLM_SERVER_PLATFORM=auto                 # auto | cuda | rocm (auto = whichever vendor tool exists)
# VLM_SERVER_GPU=auto                      # ONE index (e.g. 3; an MI250 GCD) or auto = freest GPU
# VLM_SERVER_MIN_FREE_GIB=21               # auto refuses GPUs with less free memory
# VLM_SERVER_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLM_SERVER_SERVED_MODEL_NAMES=["Qwen/Qwen3-VL-8B-Instruct","qwen3-vl-8b"]
# VLM_SERVER_HOST=127.0.0.1                # loopback: reach it remotely via an SSH tunnel
# VLM_SERVER_PORT=8100                     # 8000 is the FastAPI backend of mentormind-knowhow-ai
# VLM_SERVER_GPU_MEMORY_UTILIZATION=0.90
# VLM_SERVER_MAX_MODEL_LEN=16384           # empty = 16384 on <= 32 GB cards, 32768 above (MI250 GCD)
# VLM_SERVER_MAX_NUM_SEQS=4
# VLM_SERVER_LIMIT_MM_PER_PROMPT={"image":64,"video":0}
# VLM_SERVER_MAX_PIXELS=409600
# VLM_SERVER_EXTRA_ARGS=["--enforce-eager"]
# VLM_SERVER_EXTRA_ENV={"VLLM_ATTENTION_BACKEND":"TRITON_ATTN"}
# VLM_SERVER_SECRETS_FILE=../../.env      # host repo's .env: holds the optional VLM_SERVER_API_KEY
# --- CPU gateway (python -m vlm_server gateway) ---
# INFERENCE_HOST=127.0.0.1
# INFERENCE_PORT=18080
# INFERENCE_VLM_UPSTREAM=http://127.0.0.1:18000   # every /v1/* path the gateway does not serve itself
# INFERENCE_PROXY_TIMEOUT_S=1800
# INFERENCE_ASR_MODEL=small                       # faster-whisper; small = Systran/faster-whisper-small
# INFERENCE_ASR_DEVICE=cpu
# INFERENCE_ASR_COMPUTE_TYPE=int8
# INFERENCE_ASR_BEAM_SIZE=5
# INFERENCE_ASR_VAD=true
# INFERENCE_EMBED_MODEL=BAAI/bge-m3               # must match MentorMind's local embedder
# INFERENCE_EMBED_BATCH=16
